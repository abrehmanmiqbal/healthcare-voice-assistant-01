# Copy to .env and fill in for local development.
# Never commit a real .env file — set these as environment variables
# in the FastAPI Cloud dashboard for production instead.

# Required — free key, no card, at https://console.groq.com
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional — set this to a Postgres connection string (Neon/Supabase/Railway
# free tier all work) to guarantee patient data survives redeploys.
# Leave unset to use a local SQLite file instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
